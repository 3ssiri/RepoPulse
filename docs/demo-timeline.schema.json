{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/3ssiri/RepoPulse/docs/demo-timeline.schema.json",
  "title": "RepoPulse WebMCP Demo Timeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_file", "analysis_model", "scenes"],
  "properties": {
    "source_file": {"type": "string", "minLength": 1},
    "analysis_model": {"type": "string", "minLength": 1},
    "source_duration_seconds": {"type": "number", "minimum": 0},
    "notes": {"type": "array", "items": {"type": "string"}},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "source_start",
          "source_end",
          "evidence",
          "confidence",
          "safe_direct_cut",
          "dead_ranges"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "scan",
              "attention",
              "details",
              "human-state",
              "compare",
              "implementation",
              "close"
            ]
          },
          "status": {
            "type": "string",
            "enum": ["FOUND", "NEEDS_RERECORD"]
          },
          "source_start": {"type": ["number", "null"], "minimum": 0},
          "source_end": {"type": ["number", "null"], "minimum": 0},
          "action_time": {"type": ["number", "null"], "minimum": 0},
          "result_visible_time": {"type": ["number", "null"], "minimum": 0},
          "hold_start": {"type": ["number", "null"], "minimum": 0},
          "hold_end": {"type": ["number", "null"], "minimum": 0},
          "evidence": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "safe_direct_cut": {"type": "boolean"},
          "dead_ranges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end", "action"],
              "properties": {
                "start": {"type": "number", "minimum": 0},
                "end": {"type": "number", "minimum": 0},
                "action": {"type": "string", "enum": ["CUT", "SPEED_UP"]},
                "reason": {"type": "string"}
              }
            }
          },
          "notes": {"type": "array", "items": {"type": "string"}}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "FOUND"}}},
            "then": {
              "properties": {
                "source_start": {"type": "number"},
                "source_end": {"type": "number"}
              }
            }
          },
          {
            "if": {"properties": {"status": {"const": "NEEDS_RERECORD"}}},
            "then": {
              "properties": {
                "source_start": {"type": "null"},
                "source_end": {"type": "null"}
              }
            }
          }
        ]
      }
    }
  }
}
